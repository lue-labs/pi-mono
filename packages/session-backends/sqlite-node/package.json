{
	"name": "@lue-labs/pi-session-backend-sqlite-node",
	"version": "0.84.9",
	"description": "Node sqlite session backend for @lue-labs/pi-agent-core sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
		"test": "vitest --run",
		"coverage": "vitest --run --coverage",
		"prepublishOnly": "npm run clean && npm run build",
		"bench:session:timing": "vitest bench --config vitest.benchmark.config.ts"
	},
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lue-labs/pi-mono.git",
		"directory": "packages/session-backends/sqlite-node"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@lue-labs/pi-ai": "0.84.9",
		"@lue-labs/pi-agent-core": "0.84.9"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.9",
		"vitest": "4.1.9"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	}
}
