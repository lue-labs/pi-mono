{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		"packages/agent": {
			"entry": ["src/index.ts", "src/node.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/ai": {
			"entry": ["src/index.ts", "src/compat.ts", "src/cli.ts", "src/oauth.ts", "src/bedrock-provider.ts", "src/providers/*.ts", "src/api/*.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/coding-agent": {
			"entry": ["src/index.ts", "src/cli.ts", "src/rpc-entry.ts"],
			"project": ["src/**/*.ts"],
			"ignore": ["examples/**"]
		},
		"packages/orchestrator": {
			"entry": ["src/index.ts", "src/cli.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/tui": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		}
	},
	"ignore": ["**/test/**", "**/*.test.ts"],
	"ignoreDependencies": []
}
