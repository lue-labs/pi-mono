{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": [
				"./*"
			],
			"@earendil-works/chord": [
				"./packages/chord/src/index.ts"
			],
			"@earendil-works/chord/bundler": [
				"./packages/chord/src/bundler.ts"
			],
			"@earendil-works/chord/context": [
				"./packages/chord/src/context/index.ts"
			],
			"@earendil-works/chord/delta": [
				"./packages/chord/src/delta/index.ts"
			],
			"@earendil-works/chord/node": [
				"./packages/chord/src/node.ts"
			],
			"@lue-labs/pi-telemetry": [
				"./packages/telemetry/src/index.ts"
			],
			"@lue-labs/pi-telemetry/testing": [
				"./packages/telemetry/src/testing/index.ts"
			],
			"@lue-labs/pi-ai": [
				"./packages/ai/src/index.ts"
			],
			"@lue-labs/pi-ai/oauth": [
				"./packages/ai/src/oauth.ts"
			],
			"@lue-labs/pi-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts"
			],
			"@lue-labs/pi-ai/dist/*": [
				"./packages/ai/src/*"
			],
			"@lue-labs/pi-agent-core": [
				"./packages/agent/src/index.ts"
			],
			"@lue-labs/pi-agent-core/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@lue-labs/pi-agent-core/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@lue-labs/pi-agent-core/node": [
				"./packages/agent/src/node.ts"
			],
			"@lue-labs/pi-agent-core/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@lue-labs/pi-session-backend-sqlite-node": [
				"./packages/session-backends/sqlite-node/src/index.ts"
			],
			"@lue-labs/pi-coding-agent": [
				"./packages/coding-agent/src/index.ts"
			],
			"@lue-labs/pi-coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@lue-labs/pi-coding-agent/hooks": [
				"./packages/coding-agent/src/core/hooks/index.ts"
			],
			"@lue-labs/pi-coding-agent/*": [
				"./packages/coding-agent/src/*"
			],
			"@lue-labs/pi-protocol": [
				"./packages/protocol/src/index.ts"
			],
			"@lue-labs/pi-protocol/*": [
				"./packages/protocol/src/*"
			],
			"@lue-labs/pi-client": [
				"./packages/client/src/index.ts"
			],
			"@lue-labs/pi-client/unix": [
				"./packages/client/src/unix.ts"
			],
			"@lue-labs/pi-client/*": [
				"./packages/client/src/*"
			],
			"@lue-labs/pi-server": [
				"./packages/server/src/index.ts"
			],
			"@lue-labs/pi-server/unix": [
				"./packages/server/src/transports/unix/index.ts"
			],
			"@lue-labs/pi-server/*": [
				"./packages/server/src/*"
			],
			"typebox": [
				"./node_modules/typebox"
			],
			"@lue-labs/pi-tui": [
				"./packages/tui/src/index.ts"
			],
			"@lue-labs/pi-tui/*": [
				"./packages/tui/src/*"
			],
			"@earendil-works/pi-agent-old": [
				"./packages/agent-old/src/index.ts"
			],
			"@earendil-works/pi-agent-old/*": [
				"./packages/agent-old/src/*"
			],
			"@earendil-works/pi-telemetry": [
				"./packages/telemetry/src/index.ts"
			],
			"@earendil-works/pi-telemetry/testing": [
				"./packages/telemetry/src/testing/index.ts"
			],
			"@earendil-works/pi-ai": [
				"./packages/ai/src/index.ts"
			],
			"@earendil-works/pi-ai/oauth": [
				"./packages/ai/src/oauth.ts"
			],
			"@earendil-works/pi-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts"
			],
			"@earendil-works/pi-ai/dist/*": [
				"./packages/ai/src/*"
			],
			"@earendil-works/pi-durable": [
				"./packages/durable/src/index.ts"
			],
			"@earendil-works/pi-durable/*": [
				"./packages/durable/src/*"
			],
			"@earendil-works/pi-agent-core": [
				"./packages/agent/src/index.ts"
			],
			"@earendil-works/pi-agent-core/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@earendil-works/pi-agent-core/experimental/pico3": [
				"./packages/agent/src/harness/pico3/index.ts"
			],
			"@lue-labs/pi-agent-core/experimental/pico3": [
				"./packages/agent/src/harness/pico3/index.ts"
			],
			"@earendil-works/pi-agent-core/node": [
				"./packages/agent/src/node.ts"
			],
			"@earendil-works/pi-agent-core/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@earendil-works/pi-session-backend-sqlite-node": [
				"./packages/session-backends/sqlite-node/src/index.ts"
			],
			"@earendil-works/pi-coding-agent": [
				"./packages/coding-agent/src/index.ts"
			],
			"@earendil-works/pi-coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@earendil-works/pi-coding-agent/hooks": [
				"./packages/coding-agent/src/core/hooks/index.ts"
			],
			"@earendil-works/pi-coding-agent/*": [
				"./packages/coding-agent/src/*"
			],
			"@earendil-works/pi-protocol": [
				"./packages/protocol/src/index.ts"
			],
			"@earendil-works/pi-protocol/*": [
				"./packages/protocol/src/*"
			],
			"@earendil-works/pi-client": [
				"./packages/client/src/index.ts"
			],
			"@earendil-works/pi-client/unix": [
				"./packages/client/src/unix.ts"
			],
			"@earendil-works/pi-client/*": [
				"./packages/client/src/*"
			],
			"@earendil-works/pi-server": [
				"./packages/server/src/index.ts"
			],
			"@earendil-works/pi-server/unix": [
				"./packages/server/src/transports/unix/index.ts"
			],
			"@earendil-works/pi-server/*": [
				"./packages/server/src/*"
			],
			"@earendil-works/pi-tui": [
				"./packages/tui/src/index.ts"
			],
			"@earendil-works/pi-tui/*": [
				"./packages/tui/src/*"
			]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/session-backends/*/src/**/*",
		"packages/session-backends/*/test/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": [
		"packages/coding-agent/examples/extensions/sandbox/**",
		"packages/coding-agent/examples/extensions/gondolin/**",
		"**/dist/**"
	]
}
